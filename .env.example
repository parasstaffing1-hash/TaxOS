# Application
APP_NAME=TaxOS
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development
SECRET_KEY=local-development-secret-change-before-production
FIELD_ENCRYPTION_KEY=local-development-field-key-change-before-production
POSTGRES_PASSWORD=local-development-password
# Comma-separated allowlist for calculator configuration, update, and verification access.
ADMIN_EMAILS=admin@example.com
# Keep updater, analytics, and verification routes out of production unless explicitly enabled.
ENABLE_INTERNAL_TOOLS=false

# API
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database
# For Aiven PostgreSQL, replace DATABASE_URL with the Aiven service URL and
# change the scheme to postgresql+asyncpg:// (keep sslmode=require or stronger).
DATABASE_URL=postgresql+asyncpg://taxos:local-development-password@localhost:5432/taxos
# Optional Docker Compose override. Leave blank to use the bundled db; set this
# to your Aiven URL when the API should use managed PostgreSQL.
TAXOS_DATABASE_URL=
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Object storage
# Use local for development. Set STORAGE_BACKEND=r2 in production after
# creating a bucket and an R2 Object Read & Write token scoped to that bucket.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=.storage
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=taxos-documents
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
TRUSTED_PROXIES=[]
